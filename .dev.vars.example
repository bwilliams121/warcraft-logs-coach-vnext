# Local development secrets for `wrangler dev`.
#
# Copy this file to `.dev.vars` and fill in real values:
#
#     Copy-Item .dev.vars.example .dev.vars
#
# `.dev.vars` is gitignored and must never be committed.
#
# These are BACKEND SECRETS. They must never reach browser code, WoW addon code,
# API responses, logs, error messages, or committed fixtures.
#
# Obtain a client ID/secret by creating a Warcraft Logs API client at:
#     https://www.warcraftlogs.com/api/clients/
#
# For Cloudflare deployments, do NOT put these in wrangler.jsonc. Use:
#     npx wrangler secret put WCL_CLIENT_ID
#     npx wrangler secret put WCL_CLIENT_SECRET

WCL_CLIENT_ID="replace-me"
WCL_CLIENT_SECRET="replace-me"

# INBOUND authorization for BOTH analysis surfaces: /v1/analysis and /mcp.
#
# This is a DIFFERENT concern from the two values above. Those are OUTBOUND:
# how this service authenticates to Warcraft Logs. This one is INBOUND: who is
# allowed to call this service's MCP endpoint at all.
#
# One credential, two surfaces. Both fail closed: if this value is unset, every
# analysis request is rejected with 401 — an unset token never means "no token
# required". /health is unaffected and stays public.
#
# Authentication is not the same thing as the rate limiter. Cloudflare's Worker
# Rate Limiting counters are location-local and eventually consistent, so they
# are a brake on an authorized caller, never a door.
#
# Generate a high-entropy value, for example:
#     python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# For Cloudflare deployments, do NOT put this in wrangler.jsonc. Use:
#     npx wrangler secret put ANALYSIS_AUTH_TOKEN
#
# This is the private-development protection mechanism for Milestone 6. It is
# not OAuth, not multi-user identity, and not the final ChatGPT-facing
# authentication design; Cloudflare Access or OAuth remain open for production
# exposure.

ANALYSIS_AUTH_TOKEN="replace-me"

# The analysis rate limiter is a Cloudflare binding, not a secret. It is
# declared in wrangler.jsonc as ANALYSIS_RATE_LIMITER (10 requests / 60s) and
# needs no value here and no dashboard resource.
#
# Cloudflare's rate-limit binding is not exercised by local `wrangler dev` or by
# the offline test suite. Both analysis paths FAIL CLOSED when the limiter is
# unavailable, so a local run without it will refuse analysis rather than run
# unmetered. Tests inject a limiter port instead.
