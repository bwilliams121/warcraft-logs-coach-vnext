  "costFormulaChecks": [
    {
      "claim": "ACTION_COST_FORMULA",
      "source": "engine/action/action.cpp",
      "finding": "action_t::cost() computes ( base + bc.flat_add + cost_flat_modifier() ) * bc.pct_mul * cost_pct_multiplier(), and clamps a negative result to 0"
    },
    {
      "claim": "BASE_COST_FLAT_MODIFIER_ONLY_SUBTRACTS_A_REDUCTION",
      "source": "engine/action/action.cpp",
      "finding": "action_t::cost_flat_modifier() returns -player->current.resource_reduction[ school ]"
    },
    {
      "claim": "BASE_COST_PCT_MULTIPLIER_IS_ONE",
      "source": "engine/action/action.cpp",
      "finding": "action_t::cost_pct_multiplier() returns 1.0"
    },
    {
      "claim": "RESOURCE_REDUCTION_CHANGES_ONLY_IN_NON_NEGATIVE_AMOUNTS",
      "source": "engine/player/player.cpp",
      "finding": "player_t::cost_reduction_gain / cost_reduction_loss return early on a non-positive amount, and they are the only four writes to current.resource_reduction"
    },
    {
      "claim": "CLASS_MODULE_OVERRIDES_NO_COST",
      "source": "engine/class_modules/monk/sc_monk.cpp, engine/class_modules/monk/sc_monk.hpp",
      "finding": "0 occurrence(s) of 'cost() const override'"
    },
    {
      "claim": "CLASS_MODULE_OVERRIDES_NO_COST_FLAT_MODIFIER",
      "source": "engine/class_modules/monk/sc_monk.cpp, engine/class_modules/monk/sc_monk.hpp",
      "finding": "0 occurrence(s) of 'cost_flat_modifier'"
    },
    {
      "claim": "CLASS_MODULE_OVERRIDES_NO_COST_PCT_MULTIPLIER",
      "source": "engine/class_modules/monk/sc_monk.cpp, engine/class_modules/monk/sc_monk.hpp",
      "finding": "0 occurrence(s) of 'cost_pct_multiplier'"
    },
    {
      "claim": "CLASS_MODULE_CALLS_NO_APPLY_AFFECTING_AURA",
      "source": "engine/class_modules/monk/sc_monk.cpp, engine/class_modules/monk/sc_monk.hpp",
      "finding": "0 occurrence(s) of 'apply_affecting_aura'"
    },
    {
      "claim": "USABLE_MOVING_RULE",
      "source": "engine/action/action.cpp",
      "finding": "action_t::usable_moving() is false for a cast time, a channel, or a range in (0, 5], and true otherwise (the norgannons_sagacity exception only widens it)"
    }
