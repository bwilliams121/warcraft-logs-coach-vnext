{
  // Warcraft Logs Coach vNext — Cloudflare Worker configuration.
  //
  // SECRETS ARE NEVER STORED IN THIS FILE.
  //
  // WCL_CLIENT_ID and WCL_CLIENT_SECRET are backend secrets. Set them with:
  //
  //     npx wrangler secret put WCL_CLIENT_ID
  //     npx wrangler secret put WCL_CLIENT_SECRET
  //
  // For local development they are read from .dev.vars, which is gitignored.
  // See .dev.vars.example.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "warcraft-logs-coach-vnext",
  "main": "src/api/worker.ts",
  // Capped by the workerd bundled with @cloudflare/vitest-pool-workers, which
  // currently supports dates up to 2026-08-22. Deliberately a single shared date
  // rather than a test-only override, so tests exercise the same runtime
  // semantics as a deploy. Raise it once the pool ships a newer workerd.
  "compatibility_date": "2026-08-22",
  "observability": {
    "enabled": true,
  },
  // Non-secret configuration only.
  "vars": {
    "ENVIRONMENT": "development",
  },
  // Metering for analysis, shared by REST and MCP.
  //
  // The MCP specification requires servers to rate limit tool invocations, and
  // here that matters in money: one analyze_warcraft_log call spends Warcraft
  // Logs API points from a finite, paid, account-wide quota. An agent loop can
  // exhaust it in seconds, and no amount of retrying gets it back.
  //
  // ONE BUDGET FOR BOTH TRANSPORTS. /v1/analysis and the MCP tool charge this
  // binding under the same key, so a caller cannot double their spend by
  // switching protocols.
  //
  // 10 calls / 60s is far above interactive human use — nobody reads ten fight
  // analyses a minute — while still bounding a runaway client. The limiter is
  // checked immediately before the shared analysis runner on each transport, so
  // tools/list, rejected requests and unparseable bodies do not consume it.
  //
  // namespace_id must be a positive integer string unique within the Cloudflare
  // account. No other rate-limit binding exists in this repository; Cloudflare
  // treats bindings sharing a namespace and key as sharing one counter, so this
  // value must not be reused by another Worker in the account for a different
  // purpose.
  //
  // Period must be 10 or 60. This binding needs no dashboard resource.
  "limits": {
    "cpu_ms": 120000,
  },

  "ratelimits": [
    {
      "name": "ANALYSIS_RATE_LIMITER",
      "namespace_id": "6401",
      "simple": {
        "limit": 10,
        "period": 60,
      },
    },
  ],
}
